# Environment
NODE_ENV=development

# Server
PORT=5000
API_VERSION=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinelforge_ctf
DB_USER=postgres
DB_PASSWORD=yourpassword
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Admin
ADMIN_EMAIL=admin@sentinelforge.ctf
ADMIN_PASSWORD=changeme
ADMIN_USERNAME=admin

# CTF Configuration
CTF_NAME=SentinelForge CTF
CTF_START_TIME=2025-11-01T00:00:00Z
CTF_END_TIME=2025-11-03T23:59:59Z
ALLOW_REGISTRATION=true
REQUIRE_EMAIL_VERIFICATION=false

# Scoring
FIRST_BLOOD_BONUS=50
HINT_PENALTY_PERCENTAGE=10
DYNAMIC_SCORING=true

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=.txt,.pdf,.jpg,.png,.zip

# Azure (for production)
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_APP_INSIGHTS_KEY=
